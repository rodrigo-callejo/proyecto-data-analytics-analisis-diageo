{
    "name": "Corver - Navy Professional",
    "dataColors": [
        "#112558",
        "#1A5FA8",
        "#2B82C9",
        "#3FA3D8",
        "#6BBFE6",
        "#9DD5EF",
        "#C4E8F7",
        "#0F7A8C",
        "#1A9BAD",
        "#3DBCCC",
        "#72D4DF",
        "#A8E6ED",
        "#1D4ED8",
        "#4F7FCC",
        "#7FA8DC",
        "#B0CBE8",
        "#2D6A8A",
        "#5590A8",
        "#82B4C6",
        "#ADD5E0",
        "#164E63",
        "#1F6E8C",
        "#3A92AE",
        "#6AB4CA",
        "#96CFE0",
        "#475569",
        "#64748B",
        "#94A3B8",
        "#CBD5E1",
        "#E2EBF0",
        "#0F5C55",
        "#1C2325"
    ],
    "background": "#F0F2F5",
    "foreground": "#111827",
    "tableAccent": "#112558",
    "visualStyles": {
        "*": {
            "*": {
                "title": [
                    {
                        "show": true,
                        "fontFamily": "Segoe UI Semibold",
                        "fontSize": 14,
                        "color": {
                            "solid": {
                                "color": "#111827"
                            }
                        }
                    }
                ],
                "background": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        },
                        "transparency": 0
                    }
                ],
                "border": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#E5E7EB"
                            }
                        },
                        "radius": 12
                    }
                ],
                "dropShadow": [
                    {
                        "show": true,
                        "color": {
                            "solid": {
                                "color": "#000000"
                            }
                        },
                        "transparency": 95,
                        "blur": 15,
                        "angle": 135,
                        "distance": 4,
                        "shadowPosition": "Outer"
                    }
                ],
                "visualTooltip": [
                    {
                        "type": "Default"
                    }
                ]
            }
        },
        "tableEx": {
            "*": {
                "columnHeaders": [
                    {
                        "backColor": {
                            "solid": {
                                "color": "#112558"
                            }
                        },
                        "fontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        }
                    }
                ],
                "total": [
                    {
                        "backColor": {
                            "solid": {
                                "color": "#112558"
                            }
                        },
                        "fontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        }
                    }
                ]
            }
        },
        "pivotTable": {
            "*": {
                "columnHeaders": [
                    {
                        "backColor": {
                            "solid": {
                                "color": "#112558"
                            }
                        },
                        "fontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        }
                    }
                ],
                "subtotals": [
                    {
                        "backColor": {
                            "solid": {
                                "color": "#112558"
                            }
                        },
                        "fontColor": {
                            "solid": {
                                "color": "#FFFFFF"
                            }
                        }
                    }
                ]
            }
        },
        "actionButton": {
            "*": {
                "visualContainerObjects": {
                    "dropShadow": [
                        {
                            "show": false
                        }
                    ]
                }
            }
        }
    }
}