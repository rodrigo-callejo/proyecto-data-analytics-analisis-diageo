model Model
	culture: es-ES
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: es-ES
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Eurostat

	annotation PBI_QueryGroupOrder = 0

queryGroup Maestras

	annotation PBI_QueryGroupOrder = 1

queryGroup INE

	annotation PBI_QueryGroupOrder = 2

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Años","Empresa","INE - Precios consumo","SABI - Empresas competidores Españolas","EUROSTAT - Datos Macro"]

ref table Años
ref table Empresa
ref table 'SABI - Empresas competidores Españolas'
ref table 'EUROSTAT - Datos Macro'
ref table 'Selector métrica SABI'
ref table 'Selector métrica EUROSTAT'

ref cultureInfo es-ES

