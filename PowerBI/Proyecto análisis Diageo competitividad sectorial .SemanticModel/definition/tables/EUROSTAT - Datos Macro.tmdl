	partition 'EUROSTAT - Datos Macro' = m
		mode: import
		source =
				let
				    Origen = Excel.Workbook(File.Contents("C:\Users\rodri\Documents\Proyectos\Personal\proyecto-ade-gema\Datos-Tratados\EUROSTAT.xlsx"), null, true),
				    #"Datos finales_Sheet" = Origen{[Item="Datos finales",Kind="Sheet"]}[Data],
				    #"Encabezados promovidos" = Table.PromoteHeaders(#"Datos finales_Sheet", [PromoteAllScalars=true]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(#"Encabezados promovidos", {
				        {"Región Mercado", type text},
				        {"País", type text},
				        {"Año", Int64.Type},
				        {"Num Empresas", Int64.Type},
				        {"Facturación €", type number},
				        {"Valor Producción €", type number},
				        {"Margen Bruto €", type number},
				        {"Valor Añadido €", type number}
				    })
				in
				    #"Tipo cambiado"

